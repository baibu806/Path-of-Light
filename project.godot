; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="遗迹光路"
run/main_scene="res://scenes/game_shell.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/Icons/Sprites/icon_lighthouse.png"

[audio]

default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1536
window/size/viewport_height=1024
window/size/window_width_override=1152
window/size/window_height_override=768
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.02, 0.045, 0.07, 1)
